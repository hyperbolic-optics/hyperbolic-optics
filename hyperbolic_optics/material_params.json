    "biaxial_materials": {
        "molybdenum_trioxide": {
            "name": "MoO3",
            "_source": "alpha-MoO3 (orthorhombic, biaxial), factorized TO-LO model from Alvarez-Perez et al., Adv. Mater. 32, 1908176 (2020), Table 1, correlative far-/near-field experiment column. Axis convention is the paper's own (Fig. 1a): x=[100], y=[001], z=[010]. z=[010] is the van der Waals stacking axis, so it is the out-of-plane direction of a flake lying flat and the natural geometry needs no rotation. Band assignment per Fig. 5: RB1 545-850 on [001] (y), RB2 821-963 on [100] (x), RB3 957-1007 on [010] (z). eps_inf = 5.78 / 6.07 / 4.47; the [010] value is the paper's ab-initio value, which they held fixed.",
            "frequency_range": {
                "default_min": 450.0,
                "default_max": 1100.0
            },
            "parameters": {
                "x": {
                    "high_freq": 5.78,
                    "omega_tn": [506.7, 821.4, 998.7],
                    "gamma_tn": [49.1, 6.0, 0.35],
                    "omega_ln": [534.3, 963.0, 999.2],
                    "gamma_ln": [49.1, 6.0, 0.35]
